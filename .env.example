# ---- Backend (FastAPI) ----
ENVIRONMENT=development            # "production" enforces VAPI_WEBHOOK_SECRET at startup
DATABASE_URL=sqlite:///./data/patients.db   # prod: postgresql://user:pass@host:5432/dbname
LOG_LEVEL=INFO
LOG_PII=true                       # false = mask phone/email/DOB/address in payload logs
SEED_DEMO_DATA=false               # true = insert 2 fictional demo patients when the table is empty
API_KEY=                           # optional; if set, /patients* require header X-API-Key
VAPI_WEBHOOK_SECRET=change-me      # shared secret Vapi sends as X-Vapi-Secret (generate: openssl rand -hex 32)

# ---- Only needed by voice_agent/provision_vapi.py (run from your laptop / CI) ----
VAPI_API_KEY=
PUBLIC_BASE_URL=https://your-app.onrender.com
# VAPI_ASSISTANT_ID=               # set after first run to update in place
# LLM_PROVIDER=openai  LLM_MODEL=gpt-4o
# VOICE_PROVIDER=11labs  VOICE_ID=sarah
# TRANSCRIBER_MODEL=nova-3  TRANSCRIBER_LANGUAGE=multi
